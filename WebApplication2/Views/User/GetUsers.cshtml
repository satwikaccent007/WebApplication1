@model List<DataAccessLayer.Models.UserModel>

@{
    ViewData["Title"] = "All Users";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">User Management</h2>

        <a asp-action="AddUser"
           asp-controller="User"
           class="btn btn-success">
            + Add New User
        </a>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-body">

            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Password</th>
                        <th width="250">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.Password</td>
                            <td>

                                <a asp-action="Details" asp-controller="User"
                                    asp-route-id="@user.Id" @*  this passes the id to route *@
                                   class="btn btn-info btn-sm text-white">
                                    Details
                                </a>

                                <a asp-action="Edit" asp-controller="User"
                                   asp-route-id="@user.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-controller="User"
                                   asp-route-id="@user.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this user?')">
                                    Delete
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>