@model List<WebApplication1.Models.OrderModel>

@*This line is like basically doing like ViewData.Model = orders;*@
<div class="container mt-5">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Orders List</h3>

            <a asp-controller="Order"
               asp-action="SubmitOrder"
               class="btn btn-light">
                + Add Order
            </a>
        </div>

        <div class="card-body">

            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.Name</td>
                            <td>₹@order.Price</td>

                            <td>
                                <a asp-controller="Order"
                                   asp-action="UpdateOrder"
                                   asp-route-orderId="@order.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Order"
                                      asp-action="DeleteOrder"
                                      method="post">

                                    <input type="hidden"
                                           name="orderId"
                                           value="@order.Id" />

                                    <button type="submit" class="btn btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>