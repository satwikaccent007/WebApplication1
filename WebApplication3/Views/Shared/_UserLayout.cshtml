<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - User Management</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication3.styles.css" asp-append-version="true" />

    <style>
            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                background: #f4f7fc;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Navbar */
            .navbar-custom {
                background: #1e293b;
            }

            .navbar-brand {
                font-size: 28px;
                font-weight: bold;
            }

            .nav-link {
                font-size: 18px;
                color: white !important;
                margin-left: 15px;
            }

                .nav-link:hover {
                    color: #cbd5e1 !important;
                }

            /* Main Content */
            .main-content {
                flex: 1 0 auto;
                width: 100%;
                padding-top: 40px;
                padding-bottom: 40px;
            }

            .content-card {
                background: white;
                padding: 30px;
                border-radius: 15px;
                box-shadow: 0px 4px 15px rgba(0, 0, 0, .1);
            }

            /* Logout */
            .logout-btn {
                margin-left: 15px;
                font-size: 16px;
                padding: 7px 18px;
                border-radius: 8px;
            }

            /* Footer */
            footer {
                flex-shrink: 0;
                width: 100%;
                background: #1e293b;
                color: white;
                text-align: center;
                padding: 15px;
                margin-top: auto;
            }
    </style>
</head>

<body>

    <!-- Navigation -->
    
    <partial name="_Header"/>

    <!-- Main Content -->
    <main class="container main-content">

        <div class="content-card">

            @RenderBody()

        </div>

    </main>


    <!-- Footer -->
    
    <partial name="_Footer"/>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
